# ============================================================
# Groww Mutual Fund FAQ Assistant — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Groq (console.groq.com) ---
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Hugging Face Inference API (online-only embeddings) ---
HF_API_KEY=hf_your-token
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
EMBED_BATCH_SIZE=32

# --- Retrieval / RAG tuning (configurable thresholds) ---
MIN_SIMILARITY_SCORE=0.35
TOP_K=8
FINAL_TOP_K=4

# --- API ---
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CHAT_RATE_LIMIT=30/minute
API_HOST=0.0.0.0
API_PORT=8000
INGEST_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
